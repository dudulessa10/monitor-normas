# Modelo das variáveis do Monitor de Normas. NÃO coloque valores reais neste arquivo.
#
# Na VM: copie para .env (na mesma pasta) e preencha:
#   cp .env.example .env && chmod 600 .env && nano .env
# O .env NÃO vai para o Git. Ele é lido apenas pelos serviços systemd deste projeto e por
# deploy/monitor.sh. Não é carregado no seu terminal nem afeta outras aplicações da máquina.
#
# No Windows (desenvolvimento) o .env é opcional: sem ele tudo fica na pasta do projeto.
# Regras: uma variável por linha, sem espaços em volta do =, sem aspas, sem $ ou ` nos valores
# (o arquivo também é lido pelo bash).

# ---------------------------------------------------------------- servidor (Python)

# Pasta de dados/, relatorios/ e logs/, fora da pasta do código.
MONITOR_NORMAS_BASE=/var/lib/monitor-normas

# Chave das âncoras do ledger: separada de dados/ e fora dos backups.
MONITOR_NORMAS_PASTA_SEGURA=/var/lib/monitor-normas/chave

# Usuário e senha das telas e da API. Sem senha, o servidor fica aberto.
# Gere uma senha com: openssl rand -hex 16
MONITOR_NORMAS_USUARIO=admin
MONITOR_NORMAS_SENHA=

# Para onde vão as cópias diárias de dados/ e por quantos dias ficam.
MONITOR_NORMAS_BACKUP=/var/lib/monitor-normas-backups
MONITOR_NORMAS_BACKUP_DIAS=30

# Fuso horário dos horários do relatório e do agendamento.
TZ=America/Sao_Paulo

# ---------------------------------------------------------------- frontend (só desenvolvimento)

# Para onde o `npm run dev` repassa as chamadas /api. Não é usado na VM nem vai para o navegador.
FRONTEND_PROXY_API=http://127.0.0.1:8000
