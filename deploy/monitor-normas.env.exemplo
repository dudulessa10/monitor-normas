# Copie para /etc/monitor-normas/monitor-normas.env (dono root, permissão 600).
# Lido pelos serviços systemd do servidor web, da execução diária e do backup.

# dados/, relatorios/ e logs/ ficam aqui, fora da pasta do código
MONITOR_NORMAS_BASE=/var/lib/monitor-normas

# chave das âncoras do ledger: separada de dados/ e fora dos backups
MONITOR_NORMAS_PASTA_SEGURA=/var/lib/monitor-normas/chave

# senha das telas e da API (sem ela, o servidor fica aberto). Sem espaços, aspas, $ ou `:
# o arquivo também é lido pelo bash (deploy/monitor.sh). Ex.: openssl rand -hex 16
MONITOR_NORMAS_USUARIO=admin
MONITOR_NORMAS_SENHA=troque-por-uma-senha-longa

# para onde vão as cópias diárias e por quantos dias ficam
MONITOR_NORMAS_BACKUP=/var/lib/monitor-normas-backups
MONITOR_NORMAS_BACKUP_DIAS=30

TZ=America/Sao_Paulo
