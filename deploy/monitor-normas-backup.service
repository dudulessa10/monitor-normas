# Cópia diária de dados/. Disparada pelo monitor-normas-backup.timer.
# Modelo: @PASTA@ é trocado pela pasta do projeto pelo deploy/instalar-servicos.sh.
[Unit]
Description=Monitor de Normas - cópia de dados/

[Service]
Type=oneshot
User=monitor-normas
Group=monitor-normas
EnvironmentFile=@PASTA@/.env
ExecStart=@PASTA@/deploy/backup.sh

StateDirectory=monitor-normas monitor-normas-backups
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/var/lib/monitor-normas /var/lib/monitor-normas-backups
