# Uma rodada de todos os alvos ativos. Disparada pelo monitor-normas-run.timer.
# Não depende do servidor web; as duas execuções nunca se sobrepõem (trava em dados/monitor.lock).
[Unit]
Description=Monitor de Normas - execução agendada
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=monitor-normas
Group=monitor-normas
WorkingDirectory=/opt/monitor-normas
EnvironmentFile=/etc/monitor-normas/monitor-normas.env
ExecStart=/opt/monitor-normas/.venv/bin/python monitor.py run --origem agendamento
# 3 = outra execução estava em andamento (não é falha). 1 = algum alvo falhou: fica como "failed".
SuccessExitStatus=3
TimeoutStartSec=1h

StateDirectory=monitor-normas
StateDirectoryMode=0750
UMask=0027
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/monitor-normas
